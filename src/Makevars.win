PKG_CPPFLAGS = -DNO_CGI -DUSE_WEBSOCKET -DUSE_IPV6 -DUSE_MBEDTLS \
  -DMG_EXTERNAL_FUNCTION_mg_cry_internal_impl \
  -DMBEDTLS_USER_CONFIG_FILE=\"civetwebr_mbedtls_config.h\" \
  -Icivetweb -Imbedtls/include

# ws2_32 for sockets, bcrypt for Mbed TLS's entropy source on Windows.
PKG_LIBS = -lws2_32 -lbcrypt

MBEDTLS_OBJECTS = $(patsubst %.c,%.o,$(wildcard mbedtls/library/*.c))
OBJECTS = civetweb.o server.o init.o $(MBEDTLS_OBJECTS)
